# ======================
# 기본 정책: 텍스트 파일 자동 감지 후 LF 통일
# ======================
* text=auto eol=lf

# ======================
# Unity 스크립트 & 셰이더
# ======================
*.cs            text eol=lf
*.shader        text eol=lf
*.cginc         text eol=lf
*.compute       text eol=lf
*.hlsl          text eol=lf

# ======================
# 데이터 & 문서
# ======================
*.json          text eol=lf
*.xml           text eol=lf
*.txt           text eol=lf
*.md            text eol=lf
*.asmdef        text eol=lf

# ======================
# Unity 에디터 설정 파일
# ======================
*.asset         text eol=lf
*.meta          text eol=lf
*.unity         text eol=lf
*.prefab        text eol=lf
*.mat           text eol=lf
*.anim          text eol=lf
*.controller    text eol=lf

# ======================
# 바이너리 파일 (변환 제외)
# ======================
*.dll           binary
*.exe           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.tga           binary
*.gif           binary
*.mp3           binary
*.ogg           binary
*.wav           binary
*.fbx           binary
*.mp4           binary
*.mov           binary
*.webm          binary

